{
  "agent": "support-ops",
  "allowed_tools": ["search_docs", "read_doc", "get_ticket", "write_report"],
  "approval_required": ["write_report"],
  "allow_write": true,
  "allow_network": false,
  "allow_shell": false,
  "limits": {
    "max_steps": 6,
    "max_tool_calls": 5,
    "timeout_s": 8.0,
    "max_tokens": 4000,
    "max_repeats": 2
  },
  "max_read_bytes": 8000,
  "max_write_bytes": 8000,
  "notes": "Read-only except for reports/. No network. No shell. Writes need approval."
}
