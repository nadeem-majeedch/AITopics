# Copy to .env and fill in only what you need. Never commit .env.
#
# The conversational AI core path needs NO values from this file: the default
# backend is a deterministic offline client that runs with no key and no download.
#
# .env is read by your shell or by your own loader, not by this repository.

# Which model backend the chatbot projects use: fake | local | api
#   fake  - deterministic extractive stand-in, offline (default)
#   local - a transformers model you have already cached locally
#   api   - an OpenAI-compatible endpoint (opt-in, requires consent)
CHATBOT_BACKEND=fake

# --- Local model (backend=local) -------------------------------------------
# Download size is real: a 0.5B model is roughly 1 GB. Keep the cache out of Git.
CHATBOT_LOCAL_MODEL=

# --- Hosted API (backend=api) ----------------------------------------------
# Leave blank unless you have read the provider's data-retention terms and have
# permission to send your documents to it. Reading this value happens in
# chatbot_core/model_client.py; it is never printed or logged.
CHATBOT_API_KEY=
CHATBOT_BASE_URL=https://api.openai.com/v1
CHATBOT_MODEL=

# --- Optional ---------------------------------------------------------------
# Set to 1 to allow sentence-transformers embeddings instead of the offline
# hashing embedder. Requires requirements/llm.txt.
CHATBOT_SEMANTIC_EMBEDDINGS=0
